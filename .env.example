# Production Neon PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/brocrewz_db?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Security & JWT Configuration
JWT_SECRET=YourSuperSecretLongJwtKeyForProductionSigningMin64CharactersLong1234567890

# Server Port
PORT=8080

# Mail Server Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Frontend API Endpoint
VITE_API_BASE_URL=https://your-render-backend-url.onrender.com

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/brocrewz_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect

# Security & JWT Configuration
JWT_SECRET=YourSuperSecretLongJwtKeyForProductionSigningMin64CharactersLong1234567890

# Server Port
PORT=8080

# Mail Server Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Frontend API Endpoint (Optional proxy override)
VITE_API_BASE_URL=http://localhost:8080
